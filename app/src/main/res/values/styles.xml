<resources>
    <color name="ivory">#F5F1E8</color>
    <string name="app_name">Personal OS</string>
    <style name="Theme.PersonalOS" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/ivory</item>
    </style>
    <style name="Theme.PersonalOS.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ivory</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/leaf</item>
        <item name="postSplashScreenTheme">@style/Theme.PersonalOS</item>
    </style>
</resources>
